local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

print("--- DIAGNOSTIC START ---")
print("Game Name: " .. game.Name)
print("Local Player: " .. LocalPlayer.Name)
print("Team: " .. (LocalPlayer.Team and LocalPlayer.Team.Name or "None"))
print("TeamColor: " .. LocalPlayer.TeamColor)
print("Character: " .. (LocalPlayer.Character and LocalPlayer.Character.Name or "None"))

if LocalPlayer.Character then
    print("\n--- CHARACTER STRUCTURE ---")
    for _, desc in pairs(LocalPlayer.Character:GetDescendants()) do
        if desc:IsA("BasePart") or desc:IsA("Model") or desc:IsA("Humanoid") then
            print(string.format("Class: %-12s | Name: %-20s | Parent: %-20s", 
                desc.ClassName, 
                desc.Name, 
                (desc.Parent and desc.Parent.Name or "Workspace")
            ))
        end
    end
end

print("\n--- OTHER PLAYERS ---")
for _, p in pairs(Players:GetPlayers()) do
    if p ~= LocalPlayer and p.Character then
        print(string.format("\nPlayer: %-15s | Team: %-10s | TeamColor: %-10s", 
            p.Name, 
            (p.Team and p.Team.Name or "None"), 
            p.TeamColor
        ))
        
        -- Print first 5 base parts of this player
        local count = 0
        for _, desc in pairs(p.Character:GetDescendants()) do
            if desc:IsA("BasePart") then
                print(string.format("   Part: %-20s | Pos: %.1f, %.1f, %.1f", 
                    desc.Name, 
                    desc.Position.X, desc.Position.Y, desc.Position.Z
                ))
                count += 1
                if count >= 5 then break end
            end
        end
    end
end
print("--- DIAGNOSTIC END ---")
