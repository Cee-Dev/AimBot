        lbl.BackgroundColor3 = Color3.new(0,0,0)
        lbl.BackgroundTransparency = 1
        return lbl
    end,
    
    newButton = function(props)
        local btn = FLOWHUB.new("TextButton", props)
        btn.Font = FLOWHUB.Font
        btn.TextColor3 = FLOWHUB.Colors.TextPrimary
        btn.BackgroundColor3 = FLOWHUB.Colors.Panel
        btn.AutoButtonColor = true
        return btn
    end,
    
    newStroke = function(parent, props)
        local stroke = FLOWHUB.new("UIStroke", props)
        stroke.Parent = parent
        return stroke
    end,
    
    -- Custom Toggle Switch
    newToggle = function(props)
        local toggle = FLOWHUB.newFrame({
            Name = "Toggle",
            Size = UDim2.new(0, 44, 0, 22),
            BackgroundColor3 = FLOWHUB.Colors.Border,
            ZIndex = 10
        }, 11)
        
        local knob = FLOWHUB.newFrame({
            Name = "Knob",
            Parent = toggle,
            Size = UDim2.new(0, 18, 0, 18),
            Position = UDim2.new(0, 2, 0, 2),
            BackgroundColor3 = FLOWHUB.Colors.TextPrimary,
            ZIndex = 11
        }, 9)
        
        local state = { active = false }
        
        toggle.MouseButton1Click:Connect(function()
            state.active = not state.active
            if state.active then
                toggle.BackgroundColor3 = FLOWHUB.Colors.Accent
                knob.Position = UDim2.new(1, -20, 0, 2)
            else
                toggle.BackgroundColor3 = FLOWHUB.Colors.Border
                knob.Position = UDim2.new(0, 2, 0, 2)
            end
            if props.onToggle then
                props.onToggle(state.active)
            end
        end)
        
        toggle.SetActive = function(active)
            state.active = active
            if active then
                toggle.BackgroundColor3 = FLOWHUB.Colors.Accent
                knob.Position = UDim2.new(1, -20, 0, 2)
            else
                toggle.BackgroundColor3 = FLOWHUB.Colors.Border
                knob.Position = UDim2.new(0, 2, 0, 2)
            end
        end
        
        return toggle
    end
}

