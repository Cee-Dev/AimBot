        local v = math.floor(min + rel * (max - min) + 0.5)
        TweenService:Create(fill, FAST, {Size = UDim2.new(rel, 0, 1, 0)}):Play()
        TweenService:Create(knob, FAST, {Position = UDim2.new(rel, 0, 0.5, 0)}):Play()
