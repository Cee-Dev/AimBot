local fovCircle = Drawing.new("Circle")
fovCircle.Position = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
fovCircle.Radius = State.FOVRadius
fovCircle.Color = CONFIG.THEME.accent
fovCircle.Thickness = 1
fovCircle.Transparency = 0.6
fovCircle.Visible = State.FOVEnabled
fovCircle.Filled = false

local highlightedPlayers = {}
local currentTargets = {}

local function getTargetPart(character)
    if State.AimBody then
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if hrp then return hrp end
    end
    local head = character:FindFirstChild("Head")
    if head then return head end
    return character:FindFirstChild("HumanoidRootPart")
end

local function getValidTargets()
    local targets = {}
    local myTeam = player.TeamColor
    local myHead = player.Character and player.Character:FindFirstChild("Head")
    if not myHead then return targets end
    local origin = myHead.Position
    local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)

    for _, v in pairs(Players:GetPlayers()) do
        if v ~= player and v.Character and v.Character:FindFirstChild("Humanoid") and v.Character.Humanoid.Health > 0 then
            if v.TeamColor == myTeam then continue end
            
            local targetPart = getTargetPart(v.Character)
            if targetPart then
                local screenPos, onScreen = cam:WorldToViewportPoint(targetPart.Position)
                if onScreen then
                    local distFromCenter = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                    local dist3D = (targetPart.Position - origin).Magnitude
                    if distFromCenter <= State.FOVRadius then
                        table.insert(targets, {
                            player = v, 
                            part = targetPart, 
                            screenDist = distFromCenter,
                            dist3D = dist3D
                        })
                    end
                end
            end
        end
    end
    return targets
end

local function setCharm(player, active)
    if not player or not player.Character then return end
    local char = player.Character
    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") and not part:FindFirstChildWhichIsA("Highlight") then
            if active then
                local hl = Instance.new("Highlight")
                hl.FillColor = CONFIG.THEME.accent
                hl.OutlineColor = CONFIG.THEME.accent
                hl.FillTransparency = 0.5
                hl.OutlineTransparency = 0.2
                hl.Parent = part
            end
        end
    end
end

local function clearCharm(player)
    if not player or not player.Character then return end
    for _, hl in pairs(player.Character:GetDescendants()) do
        if hl:IsA("Highlight") then hl:Destroy() end
    end
end

local function updateCharm(targets)
    local activePlayers = {}
    for _, t in ipairs(targets) do activePlayers[t.player] = true end
    
    for p, _ in pairs(highlightedPlayers) do
        if not activePlayers[p] then
            clearCharm(p)
            highlightedPlayers[p] = nil
        end
    end
    
    for p, _ in pairs(activePlayers) do
        if not highlightedPlayers[p] then
            setCharm(p, true)
            highlightedPlayers[p] = true
        end
    end
end

-- Input Handling
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.Q then State.Aiming = true end
    if input.KeyCode == Enum.KeyCode.Minus then State.FOVEnabled = not State.FOVEnabled; fovCircle.Visible = State.FOVEnabled end
    if input.KeyCode == Enum.KeyCode.Equals then State.Aiming = not State.Aiming end
    if input.KeyCode == Enum.KeyCode.RightBracket then 
        State.CharmEnabled = not State.CharmEnabled
        if not State.CharmEnabled then
            for p, _ in pairs(highlightedPlayers) do clearCharm(p) end
            highlightedPlayers = {}
        end
    end
    if input.KeyCode == Enum.KeyCode.LeftBracket then State.AimBody = not State.AimBody end
    if input.KeyCode == CONFIG.TOGGLE_KEY then State.UIVisible = not State.UIVisible end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.Q then State.Aiming = false end
end)

RunService.RenderStepped:Connect(function()
    fovCircle.Position = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    fovCircle.Radius = State.FOVRadius
    
    local targets = getValidTargets()
    currentTargets = targets
    
    if State.Aiming then
        local closest = nil
        local shortestScreenDist = math.huge
        for _, t in ipairs(targets) do
            if t.screenDist < shortestScreenDist then
                shortestScreenDist = t.screenDist
                closest = t
            end
        end
        if closest then
            cam.CFrame = CFrame.new(cam.CFrame.Position, closest.part.Position)
        end
    end
    
    if State.CharmEnabled then
        updateCharm(targets)
    else
        for p, _ in pairs(highlightedPlayers) do clearCharm(p) end
        highlightedPlayers = {}
    end
end)

