-- ═══ WAVE LOGO IMAGE — your original wave logo, embedded as a tintable image ═══
-- (falls back to the built-in badge if the executor has no writefile / getcustomasset)
local LOGO_B64 = ""

local function b64decode(data)
    local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    local lookup = {}
    for i = 1, #chars do lookup[chars:byte(i)] = i - 1 end
    local out, buf, bits = {}, 0, 0
    for i = 1, #data do
        local v = lookup[data:byte(i)]
        if v then
            buf = buf * 64 + v; bits = bits + 6
            if bits >= 8 then
                bits = bits - 8
                local byte = math.floor(buf / 2 ^ bits)
                buf = buf - byte * 2 ^ bits
                out[#out + 1] = string.char(byte)
            end
        end
    end
    return table.concat(out)
end

