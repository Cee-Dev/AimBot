local uis = game:GetService("UserInputService")
local plr = game.Players.LocalPlayer
local cam = workspace.CurrentCamera
local rs = game:GetService("RunService")

local aiming = false
local fovEnabled = true
local fovRadius = 150

-- FOV Circle
local fovCircle = Drawing.new("Circle")
fovCircle.Position = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
fovCircle.Radius = fovRadius
fovCircle.Color = Color3.fromRGB(255, 0, 0)
fovCircle.Thickness = 1
fovCircle.Transparency = 0.6
fovCircle.Visible = true
fovCircle.Filled = false

local function getClosest()
    local closest = nil
    local shortest = math.huge
    
    local myTeam = plr.TeamColor
    local myChar = plr.Character
    local myHead = myChar and myChar:FindFirstChild("Head")
    if not myHead then return nil end
    local origin = myHead.Position

    for _, v in pairs(game.Players:GetPlayers()) do
        -- Skip self, dead, or missing character
        if v ~= plr and v.Character and v.Character:FindFirstChild("Humanoid") and v.Character.Humanoid.Health > 0 then
            -- Ignore teammates
            if v.TeamColor == myTeam then continue end
            
            local head = v.Character:FindFirstChild("Head")
            if head then
                local screenPos, onScreen = cam:WorldToViewportPoint(head.Position)
                if onScreen then
                    local distFromCenter = (Vector2.new(screenPos.X, screenPos.Y) - fovCircle.Position).Magnitude
                    local dist3D = (head.Position - origin).Magnitude
                    
                    if distFromCenter <= fovRadius and dist3D < shortest then
                        -- Occlusion Check
                        local targetPos = head.Position
                        local direction = (targetPos - origin)
                        local dist = direction.Magnitude
                        
                        if dist > 0.1 then -- Avoid zero-length ray
                            local rayDir = direction.Unit
                            local rayOrigin = origin
                            local rayLength = dist - 0.5 -- Stop just short of the head to avoid self-hit
                
                            local filter = {
                                [myChar] = true,
                                [v.Character] = true -- Exclude target character too
                            }
                            
                            local hit = workspace:Raycast(
                                Ray.new(rayOrigin, rayDir * rayLength),
                                filter
                            )
                            
                            -- If no hit, the line is clear (no walls/terrain in between)
                            if not hit then
                                shortest = dist3D
                                closest = head
                            end
                        end
                    end
                end
            end
        end
    end
    return closest
end

-- Input Handling
uis.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    
    if input.KeyCode == Enum.KeyCode.Q then
        aiming = true
    end
    if input.KeyCode == Enum.KeyCode.Minus then
        fovEnabled = not fovEnabled
        fovCircle.Visible = fovEnabled
    end
    if input.KeyCode == Enum.KeyCode.Equals then
        aiming = not aiming
    end
end)

uis.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.Q then
        aiming = false
    end
end)

rs.RenderStepped:Connect(function()
    fovCircle.Position = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    
    if aiming then
        local target = getClosest()
        if target then
            cam.CFrame = CFrame.new(cam.CFrame.Position, target.Position)
        end
    end
end)
