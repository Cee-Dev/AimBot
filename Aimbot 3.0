local uis = game:GetService("UserInputService")
local plr = game.Players.LocalPlayer
local cam = workspace.CurrentCamera
local rs = game:GetService("RunService")

local aiming = false
local fovEnabled = true
local charmEnabled = true
local fovRadius = 150

-- FOV Circle
local fovCircle = Drawing.new("Circle")
fovCircle.Position = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
fovCircle.Radius = fovRadius
fovCircle.Color = Color3.fromRGB(255, 0, 0)
fovCircle.Thickness = 1
fovCircle.Transparency = 0.6
fovCircle.Visible = true
fovCircle.Filled = false

local currentTarget = nil

local function getClosest()
    local closest = nil
    local shortest = math.huge
    
    local myTeam = plr.TeamColor
    local myHead = plr.Character and plr.Character:FindFirstChild("Head")
    if not myHead then return nil end
    local origin = myHead.Position

    for _, v in pairs(game.Players:GetPlayers()) do
        if v ~= plr and v.Character and v.Character:FindFirstChild("Humanoid") and v.Character.Humanoid.Health > 0 then
            if v.TeamColor == myTeam then continue end
            
            local head = v.Character:FindFirstChild("Head")
            if head then
                local screenPos, onScreen = cam:WorldToViewportPoint(head.Position)
                if onScreen then
                    local distFromCenter = (Vector2.new(screenPos.X, screenPos.Y) - fovCircle.Position).Magnitude
                    local dist3D = (head.Position - origin).Magnitude
                    
                    if distFromCenter <= fovRadius and dist3D < shortest then
                        shortest = dist3D
                        closest = v
                    end
                end
            end
        end
    end
    return closest
end

local function setCharm(player, active)
    if not player or not player.Character then return end
    
    local char = player.Character
    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") and not part:FindFirstChildWhichIsA("Highlight") then
            if active then
                local hl = Instance.new("Highlight")
                hl.FillColor = Color3.fromRGB(255, 0, 0)
                hl.OutlineColor = Color3.fromRGB(255, 0, 0)
                hl.FillTransparency = 0.5
                hl.OutlineTransparency = 0.2
                hl.Parent = part
            end
        end
    end
end

local function clearCharm(player)
    if not player or not player.Character then return end
    for _, hl in pairs(player.Character:GetDescendants()) do
        if hl:IsA("Highlight") then
            hl:Destroy()
        end
    end
end

-- Input Handling
uis.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    
    if input.KeyCode == Enum.KeyCode.Q then
        aiming = true
    end
    if input.KeyCode == Enum.KeyCode.Minus then
        fovEnabled = not fovEnabled
        fovCircle.Visible = fovEnabled
    end
    if input.KeyCode == Enum.KeyCode.Equals then
        aiming = not aiming
    end
    if input.KeyCode == Enum.KeyCode.RightBracket then
        charmEnabled = not charmEnabled
        if not charmEnabled then
            clearCharm(currentTarget)
        end
    end
end)

uis.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.Q then
        aiming = false
    end
end)

rs.RenderStepped:Connect(function()
    fovCircle.Position = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    
    if aiming then
        local target = getClosest()
        
        -- Charm Logic
        if charmEnabled then
            if target ~= currentTarget then
                clearCharm(currentTarget)
                currentTarget = target
                if currentTarget then
                    setCharm(currentTarget, true)
                end
            end
        else
            if currentTarget then
                clearCharm(currentTarget)
                currentTarget = nil
            end
        end
        
        -- Aim Logic
        if target and target.Character then
            local head = target.Character:FindFirstChild("Head")
            if head then
                cam.CFrame = CFrame.new(cam.CFrame.Position, head.Position)
            end
        end
    else
        if currentTarget then
            clearCharm(currentTarget)
            currentTarget = nil
        end
    end
end)
