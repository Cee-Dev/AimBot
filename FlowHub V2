local function syncUI()
    if toggleRefs["Aim Lock"]           then toggleRefs["Aim Lock"].setState(aiming, true) end
    if toggleRefs["Aim at Body"]        then toggleRefs["Aim at Body"].setState(aimBody, true) end
    if toggleRefs["FOV Circle Visible"] then toggleRefs["FOV Circle Visible"].setState(fovEnabled, true) end
    if toggleRefs["Charm / Highlight"]  then toggleRefs["Charm / Highlight"].setState(charmEnabled, true) end

    infoAimLock.Text = aiming and "ON" or "OFF"
    infoAimPart.Text = aimBody and "Body" or "Head"
    infoCharm.Text   = charmEnabled and "ON" or "OFF"
end

-- ══════════════════════════════════════════════
--  INPUT HANDLING
-- ══════════════════════════════════════════════
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end

    if input.KeyCode == Enum.KeyCode.Minus then
        fovEnabled = not fovEnabled
        fovCircle.Visible = fovEnabled
        syncUI()
    elseif input.KeyCode == Enum.KeyCode.RightBracket then
        charmEnabled = not charmEnabled
        if not charmEnabled then clearAllESP() end
        syncUI()
    elseif input.KeyCode == Enum.KeyCode.LeftBracket then
        aimBody = not aimBody
        syncUI()
    end
end)

-- [L] show/hide UI and [=] aim toggle: polled every frame so they work
-- even when the game "eats" the key press.
do
    local lastL, lastEq = false, false
    RunService.Heartbeat:Connect(function()
        local typing = UserInputService:GetFocusedTextBox() ~= nil
        local l  = UserInputService:IsKeyDown(Enum.KeyCode.L)
        local eq = UserInputService:IsKeyDown(Enum.KeyCode.Equals)
        if not typing then
            if l and not lastL then toggleUI() end
            if eq and not lastEq then
                aiming = not aiming
                syncUI()
            end
        end
        lastL, lastEq = l, eq
    end)
end

-- mouse movement tracking (for drag-to-switch)
UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement then
        mouseDeltaAcc = mouseDeltaAcc + input.Delta.Magnitude
    end
end)

-- ══════════════════════════════════════════════
--  AIM LOOP  (runs after the Roblox camera script)
-- ══════════════════════════════════════════════
pcall(function() RunService:UnbindFromRenderStep("FlowHubAim") end)

RunService:BindToRenderStep("FlowHubAim", Enum.RenderPriority.Camera.Value + 1, function(dt)
    cam = workspace.CurrentCamera or cam
    fovCircle.Position = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)

    local targets = getValidTargets()
    targetCount = #targets
    local now = os.clock()

    -- dragging the mouse hard = you are steering: pause the pull briefly
    if mouseDeltaAcc > 8 then manualUntil = now + 0.1 end
    mouseDeltaAcc = 0

    -- target = enemy nearest to the crosshair (so dragging onto someone switches)
    local best, bestD = nil, math.huge
    for _, t in ipairs(targets) do
        if t.screenDist < bestD then
            bestD = t.screenDist
            best  = t
        end
    end

    if aiming and best then
        if now >= manualUntil then
            local goal  = CFrame.new(cam.CFrame.Position, best.part.Position)
            local alpha = 1 - (1 - math.clamp(aimSmooth / 100, 0.01, 1)) ^ (math.clamp(dt, 0, 0.1) * 60)
            cam.CFrame  = cam.CFrame:Lerp(goal, alpha)
        end
        local sp2, onScr = cam:WorldToViewportPoint(best.part.Position)
        targetMarker.Position = Vector2.new(sp2.X, sp2.Y)
        targetMarker.Color    = (now < manualUntil) and Color3.fromRGB(235, 235, 235) or Color3.fromRGB(70, 230, 110)
        targetMarker.Visible  = onScr
    else
        targetMarker.Visible = false
    end
end)

