-- ══════════════════════════════════════════════
--  TEAM CHECK  (works for team games AND no-team games)
-- ══════════════════════════════════════════════
local function isTeammate(p)
    if p == plr then return true end
    -- Roblox Teams service
    if plr.Team ~= nil and p.Team ~= nil then
        return plr.Team == p.Team
    end
    if plr.Team ~= nil or p.Team ~= nil then
        return false
    end
    -- Team stored as an attribute (some games)
    local a, b = plr:GetAttribute("Team"), p:GetAttribute("Team")
    if a ~= nil and a == b then return true end
    -- No teams at all -> everyone else is an enemy
    return false
end

local function isAlive(character)
    local hum = character and character:FindFirstChildOfClass("Humanoid")
    return hum ~= nil and hum.Health > 0
end

-- ══════════════════════════════════════════════
--  AIM CORE
-- ══════════════════════════════════════════════
local function getTargetPart(character)
    if aimBody then
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if hrp then return hrp end
    end
    local head = character:FindFirstChild("Head")
    if head then return head end
    return character:FindFirstChild("HumanoidRootPart")
end

local function getValidTargets()
    local targets = {}
    local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)

    for _, v in ipairs(Players:GetPlayers()) do
        if v ~= plr and not isTeammate(v) and isAlive(v.Character) then
            local part = getTargetPart(v.Character)
            if part then
                local sp, onScreen = cam:WorldToViewportPoint(part.Position)
                if onScreen then
                    local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                    if d <= fovRadius then
                        table.insert(targets, {player = v, part = part, screenDist = d})
                    end
                end
            end
        end
    end
    return targets
end

-- ══════════════════════════════════════════════
--  ESP  (all enemies, visible through walls)
-- ══════════════════════════════════════════════
local espObjects = {}

local function removeESP(p)
    local h = espObjects[p]
    if h then
        pcall(function() h:Destroy() end)
        espObjects[p] = nil
    end
end

local function clearAllESP()
    for p in pairs(espObjects) do removeESP(p) end
end

local function updateESP()
    if not charmEnabled then
        clearAllESP()
        return
    end
    for _, v in ipairs(Players:GetPlayers()) do
        if v ~= plr then
            local char  = v.Character
            local valid = char ~= nil and isAlive(char) and not isTeammate(v)
            local hl    = espObjects[v]
            if valid then
                if (not hl) or hl.Parent ~= char then
                    if hl then pcall(function() hl:Destroy() end) end
                    hl = Instance.new("Highlight")
                    hl.Adornee             = char
                    hl.FillColor           = Color3.fromRGB(255, 40, 40)
                    hl.OutlineColor        = Color3.fromRGB(255, 255, 255)
                    hl.FillTransparency    = 0.55
                    hl.OutlineTransparency = 0
                    hl.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
                    hl.Parent              = char
                    espObjects[v] = hl
                end
            else
                removeESP(v)
            end
        end
    end
    for p in pairs(espObjects) do
        if not p.Parent then removeESP(p) end
    end
end

