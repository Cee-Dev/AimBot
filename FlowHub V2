            TextColor3             = active and C.Accent or C.TextMuted,
            BackgroundTransparency = active and 0.88 or 1,
        }):Play()
        tabPages[n].Visible = active
    end
    local page = tabPages[name]
    page.Position = UDim2.new(0, 0, 0, 14)
    TweenService:Create(page, TWEEN_MED, {Position = UDim2.new(0, 0, 0, 2)}):Play()
