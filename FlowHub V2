local function findTarget(list, player)
    for _, x in ipairs(list) do
        if x.player == player then return x end
    end
end

local function nearestToMe(list)
    local best, d = nil, math.huge
    for _, x in ipairs(list) do
        if x.dist3D < d then d = x.dist3D best = x end
    end
    return best
end

local function nearestToCrosshair(list)
    local best, d = nil, math.huge
    for _, x in ipairs(list) do
        if x.screenDist < d then d = x.screenDist best = x end
    end
    return best
end

RunService.RenderStepped:Connect(function(dt)
    cam = workspace.CurrentCamera or cam   -- camera can be replaced on respawn
    fovCircle.Position = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)

    local targets = getValidTargets()
    targetCount = #targets
    local now = tick()

    -- dragging the mouse = steering: pause aim assist, drop the lock,
    -- and lock onto whoever your crosshair lands on once you slow down
    if mouseDeltaAcc > 3 then
        manualUntil  = now + 0.15
        lockedPlayer = nil
        manualLock   = false
        dragPending  = true
    end
    mouseDeltaAcc = 0

    local shown = nil

    if aiming then
        if now < manualUntil then
            -- steering: preview the enemy under the crosshair
            shown = nearestToCrosshair(targets)
        else
            local pick = lockedPlayer and findTarget(targets, lockedPlayer) or nil
            local sticky = manualLock or not preferClosest

            if pick and not sticky then
                -- auto mode: switch only if someone is clearly closer to me (15%+)
                local nearest = nearestToMe(targets)
                if nearest and nearest.player ~= pick.player
                    and nearest.dist3D < pick.dist3D * 0.85 then
                    pick = nearest
                end
            end

            if not pick then
                if dragPending or not preferClosest then
                    pick = nearestToCrosshair(targets)
                    manualLock = pick ~= nil and dragPending
                else
                    pick = nearestToMe(targets)
                    manualLock = false
                end
                dragPending = false
            end

            lockedPlayer = pick and pick.player or nil
            if not pick then manualLock = false end

            if pick then
                local goal  = CFrame.new(cam.CFrame.Position, pick.part.Position)
                local alpha = 1 - (1 - math.clamp(aimSmooth / 100, 0.01, 1)) ^ (math.clamp(dt, 0, 0.1) * 60)
                cam.CFrame  = cam.CFrame:Lerp(goal, alpha)
                shown = pick
            end
        end
    else
        lockedPlayer = nil
        manualLock   = false
        dragPending  = false
    end

    if shown then
        currentTargetName = shown.player.DisplayName ~= "" and shown.player.DisplayName or shown.player.Name
        currentTargetDist = math.floor(shown.dist3D)
        local sp, onScr = cam:WorldToViewportPoint(shown.part.Position)
        targetMarker.Position = Vector2.new(sp.X, sp.Y)
        targetMarker.Color    = (now < manualUntil) and Color3.fromRGB(235, 235, 235) or Color3.fromRGB(70, 230, 110)
        targetMarker.Visible  = onScr
    else
        currentTargetName = "None"
        targetMarker.Visible = false
    end

    if charmEnabled then
        updateCharm(targets)
    else
        for p in pairs(highlightedPlayers) do clearCharm(p) end
        highlightedPlayers = {}
    end
end)

