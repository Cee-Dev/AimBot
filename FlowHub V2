-- ================= UI CONSTRUCTION =================

local function createInstance(className, props, children)
    local inst = Instance.new(className)
    for k, v in pairs(props) do
        if type(k) == "number" then
            -- Handle children array if passed as 1,2,3...
            continue
        end
        inst[k] = v
    end
    if children then
        for _, child in ipairs(children) do
            child.Parent = inst
        end
    end
    return inst
end

local function createButton(text, props)
    local btn = createInstance("TextButton", {
        Text = text,
        Font = Enum.Font.PoppinsSemiBold,
        TextSize = 14,
        TextColor3 = THEME.TEXT,
        BackgroundColor3 = THEME.BG,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 100, 0, 36),
        AutoButtonColor = false
    }, props.children or {})
    
    btn.MouseEnter:Connect(function()
        if not props.disabled then
            btn.BackgroundColor3 = THEME.BORDER
        end
    end)
    btn.MouseLeave:Connect(function()
        if not props.disabled then
            btn.BackgroundColor3 = THEME.BG
        end
    end)
    
    if props.onClick then
        btn.MouseButton1Click:Connect(function()
            props.onClick()
        end)
    end
    return btn
end

local function createToggle(label, initialOn, onChange)
    local container = createInstance("Frame", {
        Size = UDim2.new(0, 180, 0, 40),
        BackgroundColor3 = THEME.BG,
        BorderSizePixel = 0
    })
    
    local labelTxt = createInstance("TextLabel", {
        Text = label,
        Font = Enum.Font.PoppinsMedium,
        TextSize = 13,
        TextColor3 = THEME.TEXT,
        BackgroundTransparency = 1,
        Size = UDim2.new(0.6, 0, 1, 0),
        TextXAlignment = Enum.TextXAlignment.Left
    }, { Parent = container })
    
    local toggleBtn = createInstance("TextButton", {
        Text = initialOn and "ON" or "OFF",
        Font = Enum.Font.PoppinsSemiBold,
        TextSize = 12,
        TextColor3 = THEME.TEXT,
        BackgroundColor3 = initialOn and THEME.ACCENT or THEME.BORDER,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 60, 0, 24),
        Position = UDim2.new(0.65, 0, 0.5, -12),
        AutoButtonColor = false
    }, { Parent = container })
    
    toggleBtn.MouseButton1Click:Connect(function()
        local state = toggleBtn.Text == "ON"
        toggleBtn.Text = state and "OFF" or "ON"
        toggleBtn.BackgroundColor3 = state and THEME.BORDER or THEME.ACCENT
        if onChange then onChange(not state) end
    end)
    
    return container, toggleBtn
end

