local TOGGLE_DESC = {
    ["Aim Lock"]           = "Press [=] to turn on / off quickly",
    ["Aim at Body"]        = "Off = Head   |   On = Body",
    ["FOV Circle Visible"] = "Show the targeting circle on screen",
    ["Charm / Highlight"]  = "Red glow on all enemies, through walls",
}

local function makeToggle(parent, label, default, order, callback)
    local desc = TOGGLE_DESC[label]

    local row = Instance.new("Frame")
    row.Name = "Tog_" .. label
    row.Size = UDim2.new(1, 0, 0, desc and 46 or 38)
    row.BackgroundColor3 = C.Surface
    row.BorderSizePixel = 0
    row.LayoutOrder = order
    row.Parent = parent
    applyCorner(row, 6)
    local rowStroke = applyStroke(row, default and C.AccentDim or C.Border, 1)
    rowStroke.Transparency = 0.45

    row.MouseEnter:Connect(function()
        TweenService:Create(row, TWEEN_FAST, {BackgroundColor3 = C.SurfaceHov}):Play()
    end)
    row.MouseLeave:Connect(function()
        TweenService:Create(row, TWEEN_FAST, {BackgroundColor3 = C.Surface}):Play()
    end)

    local stateCol = default and C.Green or C.Red

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(0, 3, 0, 20)
    bar.Position = UDim2.new(0, 0, 0.5, -10)
    bar.BackgroundColor3 = default and C.Green or C.ToggleOff
    bar.BorderSizePixel = 0
    bar.Parent = row
    applyCorner(bar, 2)

    local glow = Instance.new("Frame")
    glow.Size = UDim2.new(0, 18, 0, 18)
    glow.Position = UDim2.new(0, 10, 0.5, -9)
    glow.BackgroundColor3 = stateCol
    glow.BackgroundTransparency = 0.82
    glow.BorderSizePixel = 0
    glow.Parent = row
    applyCorner(glow, 9)

    local dot = Instance.new("Frame")
    dot.Size = UDim2.new(0, 8, 0, 8)
    dot.Position = UDim2.new(0, 15, 0.5, -4)
    dot.BackgroundColor3 = stateCol
    dot.BorderSizePixel = 0
    dot.Parent = row
    applyCorner(dot, 4)

    local lbl = Instance.new("TextLabel")
    lbl.Size = desc and UDim2.new(1, -140, 0, 22) or UDim2.new(1, -140, 1, 0)
    lbl.Position = desc and UDim2.new(0, 36, 0, 6) or UDim2.new(0, 36, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = label
    lbl.TextColor3 = C.Text
    lbl.TextSize = 12
    lbl.Font = Enum.Font.GothamSemibold
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = row

    if desc then
        local dl = Instance.new("TextLabel")
        dl.Size = UDim2.new(1, -140, 0, 14)
        dl.Position = UDim2.new(0, 36, 0, 26)
        dl.BackgroundTransparency = 1
        dl.Text = desc
        dl.TextColor3 = C.TextMuted
        dl.TextSize = 9
        dl.Font = Enum.Font.Gotham
        dl.TextXAlignment = Enum.TextXAlignment.Left
        dl.TextTruncate = Enum.TextTruncate.AtEnd
        dl.Parent = row
    end

    local pill = Instance.new("Frame")
    pill.Size = UDim2.new(0, 40, 0, 18)
    pill.Position = UDim2.new(1, -100, 0.5, -9)
    pill.BackgroundColor3 = default and C.GreenDim or C.RedDim
    pill.BorderSizePixel = 0
    pill.Parent = row
    applyCorner(pill, 9)

    local pillTxt = Instance.new("TextLabel")
    pillTxt.Size = UDim2.new(1, 0, 1, 0)
    pillTxt.BackgroundTransparency = 1
    pillTxt.Text = default and "ON" or "OFF"
    pillTxt.TextColor3 = stateCol
    pillTxt.TextSize = 9
    pillTxt.Font = Enum.Font.GothamBold
    pillTxt.Parent = pill

    local track = Instance.new("Frame")
    track.Size = UDim2.new(0, 36, 0, 18)
    track.Position = UDim2.new(1, -48, 0.5, -9)
    track.BackgroundColor3 = default and C.Accent or C.ToggleOff
    track.BorderSizePixel = 0
    track.Parent = row
    applyCorner(track, 9)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 14, 0, 14)
    knob.Position = default and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
    knob.BackgroundColor3 = C.Text
    knob.BorderSizePixel = 0
    knob.Parent = track
    applyCorner(knob, 7)

    local state = default

    local function setState(v, skipCb)
        state = v
        local col = state and C.Green or C.Red
        TweenService:Create(track, TWEEN_FAST, {BackgroundColor3 = state and C.Accent or C.ToggleOff}):Play()
        TweenService:Create(knob, TWEEN_BACK, {
            Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
        }):Play()
        TweenService:Create(bar, TWEEN_FAST, {BackgroundColor3 = state and C.Green or C.ToggleOff}):Play()
        TweenService:Create(dot, TWEEN_FAST, {BackgroundColor3 = col}):Play()
        TweenService:Create(glow, TWEEN_FAST, {BackgroundColor3 = col}):Play()
        TweenService:Create(pill, TWEEN_FAST, {BackgroundColor3 = state and C.GreenDim or C.RedDim}):Play()
        TweenService:Create(pillTxt, TWEEN_FAST, {TextColor3 = col}):Play()
        TweenService:Create(rowStroke, TWEEN_FAST, {Color = state and C.AccentDim or C.Border}):Play()
        pillTxt.Text = state and "ON" or "OFF"
        if not skipCb and callback then callback(state) end
    end

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.Parent = row
    btn.MouseButton1Click:Connect(function() setState(not state) end)

    local ref = {setState = setState, getState = function() return state end}
    toggleRefs[label] = ref
    return ref
end

