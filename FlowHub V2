local function makeSlider(parent, label, min, max, default, order, callback)
    local row = Instance.new("Frame")
    row.Name = "Sld_" .. label
    row.Size = UDim2.new(1, 0, 0, 60)
    row.BackgroundColor3 = C.Surface
    row.BorderSizePixel = 0
    row.LayoutOrder = order
    row.Parent = parent
    applyCorner(row, 6)
    local rs = applyStroke(row, C.Border, 1)
    rs.Transparency = 0.5

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(0.6, 0, 0, 22)
    lbl.Position = UDim2.new(0, 14, 0, 4)
    lbl.BackgroundTransparency = 1
    lbl.Text = label
    lbl.TextColor3 = C.Text
    lbl.TextSize = 12
    lbl.Font = Enum.Font.GothamSemibold
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = row

    local badge = Instance.new("Frame")
    badge.Size = UDim2.new(0, 52, 0, 20)
    badge.Position = UDim2.new(1, -66, 0, 5)
    badge.BackgroundColor3 = C.Panel
    badge.BorderSizePixel = 0
    badge.Parent = row
    applyCorner(badge, 5)
    applyStroke(badge, C.AccentDim, 1)

    local valLbl = Instance.new("TextLabel")
    valLbl.Name = "Val"
    valLbl.Size = UDim2.new(1, 0, 1, 0)
    valLbl.BackgroundTransparency = 1
    valLbl.Text = tostring(default)
    valLbl.TextColor3 = C.Accent
    valLbl.TextSize = 12
    valLbl.Font = Enum.Font.GothamBold
    valLbl.Parent = badge

    local trackBg = Instance.new("Frame")
    trackBg.Size = UDim2.new(1, -28, 0, 5)
    trackBg.Position = UDim2.new(0, 14, 0, 36)
    trackBg.BackgroundColor3 = C.ToggleOff
    trackBg.BorderSizePixel = 0
    trackBg.Parent = row
    applyCorner(trackBg, 3)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    fill.BorderSizePixel = 0
    fill.Parent = trackBg
    applyCorner(fill, 3)
    local fg = Instance.new("UIGradient")
    fg.Color = ColorSequence.new(C.AccentDim, C.Accent)
    fg.Parent = fill

    local function tick(txt, xAlign, xPos)
        local tl = Instance.new("TextLabel")
        tl.Size = UDim2.new(0, 40, 0, 12)
        tl.Position = xPos
        tl.BackgroundTransparency = 1
        tl.Text = txt
        tl.TextColor3 = C.TextMuted
        tl.TextSize = 9
        tl.Font = Enum.Font.Gotham
        tl.TextXAlignment = xAlign
        tl.Parent = row
    end
    tick(tostring(min), Enum.TextXAlignment.Left,  UDim2.new(0, 14, 0, 44))
    tick(tostring(max), Enum.TextXAlignment.Right, UDim2.new(1, -54, 0, 44))

    local sKnob = Instance.new("Frame")
    sKnob.AnchorPoint = Vector2.new(0.5, 0.5)
    sKnob.Size = UDim2.new(0, 14, 0, 14)
    sKnob.Position = UDim2.new((default - min) / (max - min), 0, 0.5, 0)
    sKnob.BackgroundColor3 = C.Text
    sKnob.BorderSizePixel = 0
    sKnob.ZIndex = 3
    sKnob.Parent = trackBg
    applyCorner(sKnob, 9)
    applyStroke(sKnob, C.Accent, 2)

    local dragging = false
    local hovering = false

    local function knobSize(big)
        local s = big and 18 or 14
        TweenService:Create(sKnob, TWEEN_BACK, {Size = UDim2.new(0, s, 0, s)}):Play()
    end

    local function update(inputX)
        local rel = math.clamp((inputX - trackBg.AbsolutePosition.X) / trackBg.AbsoluteSize.X, 0, 1)
        local val = math.floor(min + rel * (max - min) + 0.5)
        TweenService:Create(fill,  TweenInfo.new(0.08), {Size = UDim2.new(rel, 0, 1, 0)}):Play()
        TweenService:Create(sKnob, TweenInfo.new(0.08), {Position = UDim2.new(rel, 0, 0.5, 0)}):Play()
        valLbl.Text = tostring(val)
        if callback then callback(val) end
    end

    local hitArea = Instance.new("TextButton")
    hitArea.Size = UDim2.new(1, -10, 0, 24)
    hitArea.Position = UDim2.new(0, 5, 0, 26)
    hitArea.BackgroundTransparency = 1
    hitArea.Text = ""
    hitArea.ZIndex = 4
    hitArea.Parent = row

    hitArea.MouseEnter:Connect(function() hovering = true knobSize(true) end)
    hitArea.MouseLeave:Connect(function()
        hovering = false
        if not dragging then knobSize(false) end
    end)
    hitArea.MouseButton1Down:Connect(function(x)
        dragging = true
        knobSize(true)
        update(x)
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            update(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 and dragging then
            dragging = false
            if not hovering then knobSize(false) end
        end
    end)

    return {
        setValue = function(v)
            local rel = math.clamp((v - min) / (max - min), 0, 1)
            fill.Size = UDim2.new(rel, 0, 1, 0)
            sKnob.Position = UDim2.new(rel, 0, 0.5, 0)
            valLbl.Text = tostring(v)
        end
    }
end

